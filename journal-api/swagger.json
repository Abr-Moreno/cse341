{
  "swagger": "2.0",
  "info": {
    "title": "Journal API",
    "description": "\n    Journal API for managing personal journal entries and retrieving public journal prompts.\n    \n    Journal entries:\n    Authenticated users can create, read, update, and delete their own journal entries. All /entries endpoints require an authenticated session. Users can only access and modify entries associated with their Auth0 user ID. Unauthenticated requests receive a 401 Unauthorized response.\n\n    Journal prompts:\n    The /prompts endpoint provides public access to the available journal prompts. Authentication is not required. Prompts are read-only through this API.\n\n    Authentication:\n    User authentication and account management are handled through Auth0's hosted login using express-openid-connect. The application maintains an authenticated session after succssful login.\n    ",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/api-docs/": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/entries/": {
      "get": {
        "description": "Retrieves all journal entries belonging to the authenticated user.",
        "responses": {
          "200": {
            "description": "Returns an array of journal entries.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JournalEntry"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Authentication required. User must be logged in to access this endpoint."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "description": "Creates a new journal entry owned by the authenticated user.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/JournalEntryInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Journal entry created successfully.",
            "schema": {
              "$ref": "#/definitions/CreateEntryResponse"
            }
          },
          "400": {
            "description": "Invalid journal entry data."
          },
          "401": {
            "description": "Authentication required. User must be logged in to access this endpoint."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/entries/{id}": {
      "get": {
        "description": "Retrieves a journal entry by ID, if it belongs to the authenticated user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the requested journal entry.",
            "schema": {
              "$ref": "#/definitions/JournalEntry"
            }
          },
          "400": {
            "description": "Invalid journal entry ID."
          },
          "401": {
            "description": "Authentication required. User must be logged in to access this endpoint."
          },
          "404": {
            "description": "Journal entry not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "description": "Updates an existing journal entry belonging to the authenticated user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/JournalEntryInput"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Journal entry updated successfully. No response body is returned."
          },
          "400": {
            "description": "Invalid journal entry ID or request body."
          },
          "401": {
            "description": "Authentication required. User must be logged in to access this endpoint."
          },
          "404": {
            "description": "Journal entry not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "description": "Deletes a journal entry, by ID, belonging to the authenticated user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Journal entry deleted successfully.",
            "schema": {
              "$ref": "#/definitions/DeleteEntryResponse"
            }
          },
          "400": {
            "description": "Invalid journal entry ID."
          },
          "401": {
            "description": "Authentication required. User must be logged in to access this endpoint."
          },
          "404": {
            "description": "Journal entry not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/prompts/": {
      "get": {
        "description": "Retrieves all journal prompts.",
        "responses": {
          "200": {
            "description": "Returns an array of journal prompts.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JournalPrompt"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "definitions": {
    "JournalEntryInput": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "A meaningful day"
        },
        "entry": {
          "type": "string",
          "example": "Today I spent time with my family and reflected on the day."
        },
        "location": {
          "type": "string",
          "example": "Amsterdam, Netherlands"
        },
        "gratitudeTags": {
          "type": "array",
          "example": [
            "family",
            "gratitude"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "JournalEntry": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "6712abc12345678901234567"
        },
        "title": {
          "type": "string",
          "example": "A meaningful day"
        },
        "entry": {
          "type": "string",
          "example": "Today I spent time with my family."
        },
        "createdAt": {
          "type": "string",
          "example": "10/17/2026, 3:02 PM"
        },
        "updatedAt": {
          "type": "string",
          "example": "10/17/2026, 3:02 PM"
        },
        "isEdited": {
          "type": "boolean",
          "example": false
        },
        "location": {
          "type": "string",
          "example": "Amsterdam, Netherlands"
        },
        "gratitudeTags": {
          "type": "array",
          "example": [
            "family",
            "gratitude"
          ],
          "items": {
            "type": "string"
          }
        },
        "userId": {
          "type": "string",
          "example": "auth0|abc123xyz"
        }
      }
    },
    "CreateEntryResponse": {
      "type": "object",
      "properties": {
        "entryCreated": {
          "type": "boolean",
          "example": true
        },
        "id": {
          "type": "string",
          "example": "6712abc12345678901234567"
        }
      }
    },
    "DeleteEntryResponse": {
      "type": "object",
      "properties": {
        "entryDeleted": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "JournalPrompt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "6712abc12345678901234567"
        },
        "prompt": {
          "type": "string",
          "example": "What is one thing you are grateful for today?"
        }
      }
    }
  }
}